@model TvcDay09LabCF.Models.TvcLoai_San_Pham
@{
    ViewData["Title"] = "Thêm mới loại sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-plus-circle"></i> @ViewData["Title"]</h4>
        </div>

        <div class="card-body">
            <form asp-action="tvcCreate">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="tvcMaLoai" class="form-label fw-bold"></label>
                    <input asp-for="tvcMaLoai" class="form-control" placeholder="Nhập mã loại sản phẩm..." />
                    <span asp-validation-for="tvcMaLoai" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="tvcTenLoai" class="form-label fw-bold"></label>
                    <input asp-for="tvcTenLoai" class="form-control" placeholder="Nhập tên loại sản phẩm..." />
                    <span asp-validation-for="tvcTenLoai" class="text-danger"></span>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" asp-for="tvcTrangThai" id="tvcTrangThai" />
                    <label class="form-check-label fw-bold text-secondary" for="tvcTrangThai">
                        @Html.DisplayNameFor(model => model.tvcTrangThai)
                    </label>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success me-2">
                        <i class="bi bi-save"></i> Ghi lại
                    </button>
                    <a asp-action="tvcIndex" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
