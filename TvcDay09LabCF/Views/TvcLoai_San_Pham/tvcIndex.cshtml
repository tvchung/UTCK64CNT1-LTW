@model IEnumerable<TvcDay09LabCF.Models.TvcLoai_San_Pham>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="tvcCreate" class="btn btn-primary">Thêm mới</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.tvcMaLoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.tvcTenLoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.tvcTrangThai)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.tvcMaLoai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.tvcTenLoai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.tvcTrangThai)
            </td>
            <td>
                <a asp-action="tvcEdit" asp-route-tvcId="@item.tvcId">Edit</a> |
                    <a asp-action="Details" asp-route-tvcId="@item.tvcId">Details</a> |
                    <a asp-action="Delete" asp-route-tvcId="@item.tvcId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
