@model TvcDay09LabCF.Models.TvcLoai_San_Pham

@{
    ViewData["Title"] = "Sửa thông tin sản phẩm";
}
@{
    ViewData["Title"] = "Chỉnh sửa loại sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0">
                <i class="bi bi-pencil-square"></i> @ViewData["Title"]
            </h4>
        </div>

        <div class="card-body">
            <form asp-action="tvcEdit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <input type="hidden" asp-for="tvcId" />

                <div class="mb-3">
                    <label asp-for="tvcMaLoai" class="form-label fw-bold"></label>
                    <input asp-for="tvcMaLoai" class="form-control" readonly />
                    <small class="text-muted">Mã loại không thể thay đổi.</small>
                    <span asp-validation-for="tvcMaLoai" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="tvcTenLoai" class="form-label fw-bold"></label>
                    <input asp-for="tvcTenLoai" class="form-control" placeholder="Nhập tên loại sản phẩm..." />
                    <span asp-validation-for="tvcTenLoai" class="text-danger"></span>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" asp-for="tvcTrangThai" id="tvcTrangThai" />
                    <label class="form-check-label fw-bold text-secondary" for="tvcTrangThai">
                        @Html.DisplayNameFor(model => model.tvcTrangThai)
                    </label>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-warning me-2 text-white">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                    <a asp-action="tvcIndex" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
