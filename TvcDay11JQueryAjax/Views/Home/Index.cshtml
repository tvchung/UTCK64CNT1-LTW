@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome, Chung Trịnh Văn</h1>
    <hr/>

    <div>
        <label for="txtFrom"><i>From</i> </label>
        <input type="text" name="txtFrom" id="txtFrom" value="Trịnh Văn Chung" />
    </div>
    <input type="button" value=" >> " />
    <div>
        <label for="txtTo">To</label>
        <input type="text" name="txtTo" id="txtTo" value="Chung Chung" />
    </div>

</div>
<div>
    <h2>Chọn màu chữ</h2>
    <div class="btn">
        <button data-value="red"> Đỏ </button>
        <button data-value="Blue"> Xanh </button>
        <button data-value="Yellow"> Vàng </button>
        <button data-value="purple"> Tím </button>
        <button data-value="#000"> Đen </button>
    </div>
    <p>
        Công ty TNHH Công nghệ xanh Thành Châu là đơn vị chuyên nghiên cứu, 
        phát triển và sản xuất các loại chế phẩm sinh học phục vụ nông nghiệp hữu cơ đặc 
        biệt là phân bón vi sinh đa chức năng Thành Châu Azotobacterin, 
        tư vấn giải pháp khoa học công nghệ phục vụ phát triển sản xuất nông nghiệp
    </p>
</div>
<div>
    <button class="btn btn-primary btn-load"> Load Data Student</button>
    <div id="lst">
        <ul>
            <li></li>
        </ul>
    </div>
</div>
@section TrinhVanChungScripts{
    <script>
        $(document).ready(function(){
            // alert('Running...');
            console.log('Running...');
            $('input[type="button"]').click(function () {
                console.log('clicked...');
                // Lấy dữ liệu từ from
                let valFrom = $('#txtFrom').val(); // Trịnh Văn Chung
                let txtValFrom = $('label[for="txtFrom"]').html(); // <i>From</i>;
                // let txtValFrom = $('label[for="txtFrom"]').text(); // From;

                $('label[for="txtTo"]').html(txtValFrom);
                $('#txtTo').val(valFrom);
            })

            // #
            $('input[type="text"]').keyup(function () {
                let valFrom = $(this).val();
                // $('#txtTo').val(valFrom);
                $(this).parent().siblings('div').children('input[type = "text"]').val(valFrom);
            })

        })
    </script>

    <script>
        $(document).ready(function(){
            $('.btn button').each(function(){
                let valColor = $(this).attr('data-value');
                $(this).css({
                    'color': valColor,
                    'width': '10rem',
                    'padding': '1rem',
                    'background': '#fff',
                }).click(function () {
                    $('p').css('color', valColor);
                });

                // $(this).click(function () { $('p').css('color', $(this).attr('data-value')); })
            })
        })
    </script>

    <script>
        $(document).ready(function () {
            
            var arrStudent = [];

            $('#lst > ul').html('');

            $('.btn-load').click(function () {
                debugger;
                $.ajax({
                    url: '/Student/GetAll',
                    type: 'GET',
                    datatype: 'json',
                    success: function (data) {
                        arrStudent = data;
                        console.log(arrStudent);
                        $.each(data, function (i, st) {
                            console.log(st);
                            $('#lst > ul').append(`<li>${st.name}  (${st.age} tuổi)</li>`);
                        });
                    },
                    error: function () {
                        alert('Không thể tải danh sách sinh viên!');
                    }
                })
            });

        });
    </script>

}